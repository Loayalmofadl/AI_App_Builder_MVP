# Server-side environment variables
# These are NEVER exposed to the browser

# Demo mode - set to 'true' to use DemoProvider (no API key needed)
# Set to 'false' to use real AI provider (requires AI_BASE_URL and AI_API_KEY)
DEMO_MODE=true

# AI Provider configuration (OpenAI-compatible)
# Only used when DEMO_MODE=false
# 
# Examples:
#   OpenAI:         AI_BASE_URL=https://api.openai.com/v1
#   Together AI:    AI_BASE_URL=https://api.together.xyz/v1
#   Groq:           AI_BASE_URL=https://api.groq.com/openai/v1
#   Local (Ollama): AI_BASE_URL=http://localhost:11434/v1
#
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Server port
PORT=3001
