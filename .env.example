# Server-side environment variables
# These are NEVER exposed to the browser

# Demo mode - set to 'true' to use DemoProvider (no API key needed)
DEMO_MODE=true

# AI Provider configuration (OpenAI-compatible)
# Only used when DEMO_MODE=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Server port
PORT=3001
